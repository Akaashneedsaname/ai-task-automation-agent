# Copy to .env and edit. Never commit .env.

# LLM provider: mock (offline, default) | anthropic | openai
LLM_PROVIDER=mock
# Optional model override; empty = provider default
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

INBOX_DIR=runtime/inbox
OUTPUT_DIR=runtime/output
DB_PATH=runtime/tasks.db
MAX_WORKERS=4
SETTLE_SECONDS=2
APPROVAL_MINUTES_THRESHOLD=30
MAX_RETRIES=2
INTERNAL_DOMAINS=bluebird.example.com
